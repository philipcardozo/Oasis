# OASIS configuration example — copy to .env and fill in. NEVER commit .env.
# Placeholders only; contains no secrets. See docs/PHASE-1-PRODUCTION-WEB.md.

# Mode: development | test | staging | production | offline
OASIS_MODE=development

# --- URLs (production requires https) ---
OASIS_PUBLIC_BASE_URL=http://localhost:8788
OASIS_API_BASE_URL=http://localhost:8788

# --- Database ---
# dev/test may use sqlite; staging/production MUST use PostgreSQL.
OASIS_DATABASE_URL=sqlite:///./data/oasis_dev.db
# OASIS_DATABASE_URL=postgresql+psycopg://oasis:CHANGE_ME@db/oasis

# --- Sessions / auth (REQUIRED >=32 chars in staging/production) ---
OASIS_SESSION_SECRET=generate-a-long-random-value-at-least-32-chars
OASIS_SESSION_COOKIE=oasis_session
OASIS_SESSION_TTL=1209600
# Forced true in staging/production regardless of this value.
OASIS_COOKIE_SECURE=false
OASIS_COOKIE_SAMESITE=lax
# Optional comma-separated private-beta invite list. Empty preserves open
# registration; staging should set this or rely on a documented outer allowlist.
OASIS_REGISTRATION_ALLOWED_EMAILS=

# --- Origins / hosts (explicit lists; no '*' in secure modes) ---
OASIS_ALLOWED_ORIGINS=http://localhost:8788
OASIS_TRUSTED_HOSTS=localhost,127.0.0.1
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For.
OASIS_TRUST_PROXY=false
# Staging-safe by default: do not cover sibling/subdomains or request preload
# until the whole approved domain hierarchy is ready.
OASIS_HSTS_MAX_AGE=31536000
OASIS_HSTS_INCLUDE_SUBDOMAINS=false
OASIS_HSTS_PRELOAD=false

# --- Email (console for dev; smtp for staging/production) ---
OASIS_EMAIL_BACKEND=console
OASIS_EMAIL_FROM=OASIS <no-reply@example.com>
# Secure modes require smtp plus a real host/sender. If either SMTP username or
# password is set, both must be set.
OASIS_SMTP_HOST=
OASIS_SMTP_PORT=587
OASIS_SMTP_STARTTLS=true
OASIS_SMTP_USER=
OASIS_SMTP_PASSWORD=

# --- Object storage (local for dev; s3 for staging/production) ---
OASIS_STORAGE_BACKEND=local
OASIS_STORAGE_DIR=outputs/storage
# When OASIS_STORAGE_BACKEND=s3 in secure modes, bucket and credentials are
# required. Cloudflare R2 also requires OASIS_S3_ENDPOINT with region=auto.
OASIS_S3_BUCKET=
OASIS_S3_REGION=
OASIS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Rate limits (requests per window) ---
OASIS_RATE_LOGIN=10
OASIS_RATE_REGISTER=5
OASIS_RATE_WRITE=60
OASIS_RATE_WINDOW=60

# --- Observability ---
OASIS_LOG_LEVEL=INFO
OASIS_LOG_JSON=false
OASIS_OTEL_ENABLED=false

# --- Licensing feature flags (default OFF in production until approved) ---
OASIS_FEATURE_SATELLITE=true
OASIS_FEATURE_PRICES=true
OASIS_FEATURE_LOGOS=true

# --- Pipeline sources (optional; used only by the worker/refresh jobs) ---
EIA_API_KEY=
DATA_GOV_API_KEY=
TNM_ACCESS_PRODUCTS_URL=https://tnmaccess.nationalmap.gov/api/v1/products
USGS_3DEP_DEM_PATH=data/raw/usgs_3dep/USGS_13_n34w085_20220725.tif

# --- Data paths (see oasis_paths.py; platform defaults when unset) ---
# OASIS_RAW_DATA_ROOT=
# OASIS_FACTS_DIR=

# --- Postgres compose password (local staging simulation only) ---
POSTGRES_PASSWORD=oasis_dev
