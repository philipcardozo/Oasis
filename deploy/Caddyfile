# Reverse proxy: TLS termination, forwarded headers, request-size limit, timeouts.
# The app already serves pre-gzipped assets, so do NOT double-compress here.
{
	admin off
}

:8443 {
	tls internal

	request_body {
		max_size 30MB
	}

	reverse_proxy api:8788 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format json
	}
}
